{
  "name": "snap-iq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SNAP IQ: QB cognition training game (iPad PWA). Phase 1: Football Bible content and validators.",
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "bible:doc": "tsx scripts/bible-doc.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run validate",
    "lab": "tsx scripts/play-lab.ts",
    "build:game": "tsx scripts/build-game.ts"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
